{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-notes",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  // Вимикає preview-URL (<версія>-my-notes.<піддомен>.workers.dev): лишається одна публічна адреса.
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp"]
  },
  // Не секретні ідентифікатори (ті самі, що потрапляють у клієнтський бандл).
  // Секрети: MCP_TOKEN, APPWRITE_API_KEY — через `wrangler secret put`.
  "vars": {
    "APPWRITE_ENDPOINT": "https://fra.cloud.appwrite.io/v1",
    "APPWRITE_PROJECT_ID": "6ac42e55002ceeb3595c",
    "APPWRITE_DATABASE_ID": "6ac43d33002ec79996c4",
    "APPWRITE_FOLDER_TABLE_ID": "6ac43d43000cf74a5e84",
    "APPWRITE_NOTE_TABLE_ID": "6ac6a10a00139886b7fd",
    "APPWRITE_NODE_TABLE_ID": "6ac43d500007cd05dd8a"
  }
}
